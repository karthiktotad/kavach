# ---------------------------------------------------------------------------
# Kavach — environment variables (TEMPLATE)
#
# Copy to `.env.local` (gitignored) and fill in real values:
#     cp .env.example .env.local
#
# EVERY value here is PUBLIC unless noted — anything prefixed with VITE_ is
# bundled into the client and MUST NOT be a secret.
#
# Rule 2: the packet-signing PRIVATE key lives ONLY in Supabase secrets.
# It is deliberately NOT part of this file. Never add it to .env, and never
# add any VITE_ variable that holds a secret.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Base URL used to build shareable SMS links / QR payloads.
# On Vercel/Cloudflare Pages this is usually injected automatically.
VITE_APP_URL=https://kavach.example.org

# --- Supabase (client-safe) -----------------------------------------------
# These expose the public anon key and project URL only. Row Level Security is
# what actually protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Content pack ----------------------------------------------------------
# Path to the preloaded offline content pack (served from public/pack).
VITE_PACK_URL=/pack/pack.json

# --- Map -------------------------------------------------------------------
# Optional tile source. Kavach MUST remain fully usable when this is unset or
# unreachable — the bundled content pack is the source of truth offline.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# --- AI assistant ----------------------------------------------------------
# Feature flag only. The model is never called from the browser; it is called
# exclusively from the Supabase Edge Function `ai-proxy`.
VITE_AI_ENABLED=true

# ---------------------------------------------------------------------------
# SERVER-ONLY — Supabase Edge Function secrets
# Set with:  supabase secrets set KEY=value
# Not read by Vite, and must NEVER appear in this file with values.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=<server only>       # bypasses RLS for ingestion
# PACKET_SIGNING_PRIVATE_KEY_PEM=<server only>  # ECDSA P-256, PKCS#8 PEM
# PACKET_SIGNING_KEY_ID=<server only>          # e.g. "kavach-pilot-2026-01"
# GEMINI_API_KEY=<server only>                 # Google AI Studio free tier
#   Model id is configurable, because Google retires names (gemini-2.0-flash
#   was removed). List what your key can reach:
#     npm run pack:translate -- --list-models
# GEMINI_MODEL=gemini-3.8-flash
# OPEN_METEO_BASE_URL=https://api.open-meteo.com
# GDACS_RSS_URL=https://www.gdacs.org/xml/rss.xml
# IMM_CAP_FEED_URL=<server only>               # NDMA SACHET / IMD CAP
# AUTHORITY_EMAILS=<server only>               # allow-list for the console